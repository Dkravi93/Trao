# Reserved for Phase 2 generation. Do not commit real credentials.
LLM_API_KEY=
LLM_MODEL=
# OpenAI-compatible chat-completions endpoint, e.g. a provider's /v1 endpoint.
LLM_BASE_URL=

# Set to true only for local evaluation fixtures hosted on localhost.
ALLOW_PRIVATE_URLS=false

# Phase 3 API. Use a MongoDB Atlas free-tier URI or a local MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/trao_interview_prep
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret
PORT=4000
# Comma-separated browser origins allowed to send cookie credentials.
CORS_ORIGIN=http://localhost:3000
